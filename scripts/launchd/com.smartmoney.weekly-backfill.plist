<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 任务标识 -->
    <key>Label</key>
    <string>com.smartmoney.weekly-backfill</string>

    <!-- 每周六上午 10:00 运行每周补全层（交易日历内部会判定，遇长假无害空跑） -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>6</integer>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- 运行命令 -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/hainingyu/Code/quant_hunter/.venv/bin/python3</string>
        <string>/Users/hainingyu/Code/quant_pipeline/daily_pipeline.py</string>
        <string>--task</string>
        <string>weekly_backfill</string>
    </array>

    <!-- 工作目录 -->
    <key>WorkingDirectory</key>
    <string>/Users/hainingyu/Code/quant_pipeline</string>

    <!-- 环境变量（与 com.smartmoney.update 保持一致） -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/hainingyu/Code/quant_hunter/.venv/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONPATH</key>
        <string>/Users/hainingyu/Code/quant_hunter</string>
        <key>QUANT_DB_PATH</key>
        <string>/Users/hainingyu/Code/quant_data/quant_core.db</string>
        <key>DISABLE_YFINANCE_FALLBACK</key>
        <string>1</string>
        <key>NOTIFICATION_TYPE</key>
        <string>console</string>
        <key>NOTIFICATION_WEBHOOK_URL</key>
        <string></string>
        <key>NOTIFICATION_LEVEL</key>
        <string>error</string>
    </dict>

    <!-- 日志输出 -->
    <key>StandardOutPath</key>
    <string>/Users/hainingyu/Code/quant_data/logs/launchd_weekly.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/hainingyu/Code/quant_data/logs/launchd_weekly.err.log</string>

    <!-- 超时 3 小时（与每日层一致） -->
    <key>Timeout</key>
    <integer>10800</integer>
</dict>
</plist>
