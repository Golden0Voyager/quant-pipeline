<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 任务标识（TUI Dashboard 的状态查询依赖这个名字，改动需同步 tui.py） -->
    <key>Label</key>
    <string>com.smartmoney.update</string>

    <!-- 模板说明（2026-09-04）：本机已停用 launchd 自动运行，本文件仅为安装模板。
         曾部署版（8/26）排期与模板不同（StartCalendarInterval 数组、周一 17:30 起），
         已删除且未留痕；重新启用时请按需修改下方排期。 -->
    <!-- 默认排期：每天 20:30（收盘结算完成之后）。
         如需限定工作日，用数组形式为 Weekday 1–5 各写一个 dict（Weekday 取值 0/1–7），
         详见 Apple launchd.plist 文档。 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>20</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <!-- 运行命令：python 解释器必须能提供 akshare/pandas 等依赖。
         用**本仓库自己的** venv（`uv sync` 生成），不要指向兄弟仓库 quant_hunter 的 venv ——
         那会让本仓库入口跑在别人的依赖集上。兄弟仓库（smartmoney_hunter）的路径由
         `core._bootstrap.ensure_sibling_paths()` 在运行期自动注入，无需在此配 PYTHONPATH。 -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/hainingyu/Code/quant_pipeline/.venv/bin/python3</string>
        <string>/Users/hainingyu/Code/quant_pipeline/daily_pipeline.py</string>
        <string>--task</string>
        <string>all</string>
    </array>

    <!-- 工作目录 -->
    <key>WorkingDirectory</key>
    <string>/Users/hainingyu/Code/quant_pipeline</string>

    <!-- 环境变量 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/hainingyu/Code/quant_pipeline/.venv/bin:/usr/local/bin:/usr/bin:/bin</string>
        <!-- 无需 PYTHONPATH：兄弟仓库路径取自 `__file__`（`core._bootstrap`），
             且曾写的 `/Users/.../quant_hunter` 根目录并不含 smartmoney_hunter 包
             （它在 quant_hunter/src 下），实际从未生效。 -->
        <!-- 指向真实数据库 -->
        <key>QUANT_DB_PATH</key>
        <string>/Users/hainingyu/Code/quant_data/quant_core.db</string>
        <!-- 禁用 yfinance fallback，防止污染黄金数据源 -->
        <key>DISABLE_YFINANCE_FALLBACK</key>
        <string>1</string>
        <!-- 无人值守告警：填好 webhook 后改为 webhook，默认 console 只写日志 -->
        <key>NOTIFICATION_TYPE</key>
        <string>console</string>
        <!-- 飞书/钉钉机器人 Webhook URL，配置后任务异常/熔断/整轮失败会主动推送 -->
        <key>NOTIFICATION_WEBHOOK_URL</key>
        <string></string>
        <!-- 推送级别：error（默认，只推失败）/ warning / info（含每日完成汇总） -->
        <key>NOTIFICATION_LEVEL</key>
        <string>error</string>
    </dict>

    <!-- 日志输出 -->
    <key>StandardOutPath</key>
    <string>/Users/hainingyu/Code/quant_data/logs/launchd_update.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/hainingyu/Code/quant_data/logs/launchd_update.err.log</string>

    <!-- 任务运行超过 3 小时自动终止（5000+ 只股票全量可能较久） -->
    <key>Timeout</key>
    <integer>10800</integer>
</dict>
</plist>
